# Copie para .env.local (para rodar no seu computador) ou cadastre na Vercel
# em Settings > Environment Variables. No Supabase, botão Connect > Framework > Next.js:
# copie as duas linhas do .env.local. (O nome antigo NEXT_PUBLIC_SUPABASE_ANON_KEY também funciona.)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Entrega 3 · API de ponto. Os valores reais NUNCA entram neste arquivo:
# cadastre-os só na Vercel (Settings > Environment Variables) ou no seu .env.local.
PONTO_API_URL=https://api-ponto-demo.vercel.app
PONTO_CLIENT_ID=seu-client-id
PONTO_API_KEY=sua-chave-aqui
PONTO_API_SECRET=seu-segredo-aqui
